resource "aws_api_gateway_rest_api" "api" {
  name = local.name
}

resource "aws_api_gateway_deployment" "deployment" {
  rest_api_id = aws_api_gateway_rest_api.api.id
  triggers = {
    redeployment = sha1(jsonencode(
      concat(
        [for key, value in local.resources : aws_api_gateway_resource.resources[key].id],
        [for key, value in local.resources : aws_api_gateway_method.methods[key].id],
        [for key, value in local.resources : aws_api_gateway_integration.integrations[key].id]
      )
    ))
  }
  lifecycle {
    create_before_destroy = true
  }
}

resource "aws_cloudwatch_log_group" "logs" {
  name = "/netex/apigateway/${local.name}"
}

resource "aws_api_gateway_stage" "stage" {
  deployment_id = aws_api_gateway_deployment.deployment.id
  rest_api_id   = aws_api_gateway_rest_api.api.id
  stage_name    = local.stage
  access_log_settings {
    destination_arn = aws_cloudwatch_log_group.logs.arn
    format          = jsonencode({ "requestId" : "$context.requestId", "ip" : "$context.identity.sourceIp", "requestTime" : "$context.requestTime", "httpMethod" : "$context.httpMethod", "routeKey" : "$context.routeKey", "status" : "$context.status", "protocol" : "$context.protocol", "responseLength" : "$context.responseLength", "integrationError" : "$context.integrationErrorMessage" })
  }
}

#######################################
## Resources endpoints               ##
#######################################

resource "aws_api_gateway_resource" "resources" {
  for_each = local.resources

  rest_api_id = aws_api_gateway_rest_api.api.id
  parent_id   = aws_api_gateway_rest_api.api.root_resource_id
  path_part   = substr(each.key, 0, 1) == "/" ? substr(each.key, 1, length(each.key) - 1) : each.key
}

resource "aws_api_gateway_method" "methods" {
  for_each = local.resources

  rest_api_id   = aws_api_gateway_rest_api.api.id
  resource_id   = aws_api_gateway_resource.resources["${each.key}"].id
  http_method   = each.value.http_method
  authorization = lookup(each.value, "authorizer", null) != null ? "CUSTOM" : "NONE"
  # authorizer_id = lookup(each.value, "authorizer_id", null) != null ? "${each.value.authorizer_id}" : lookup(each.value, "authorizer", null) != null ? aws_api_gateway_authorizer.authorizers[each.value.authorizer].id : null
  # authorizer_id = lookup(each.value, "authorizer", null) != null ? aws_api_gateway_authorizer.authorizers[each.value.authorizer].id : null
  # authorizer_id = lookup(each.value, "authorizer", null) != null ? lookup(aws_api_gateway_authorizer.authorizers, each.value.authorizer, null).id : null
  # authorizer_id = lookup(each.value, "authorizer", null) != null ? aws_api_gateway_authorizer.authorizers.id : null

  authorizer_id = aws_api_gateway_authorizer.authorizers.id

  depends_on = [aws_api_gateway_resource.resources, aws_api_gateway_authorizer.authorizers]
}

resource "aws_api_gateway_integration" "integrations" {
  for_each = local.resources

  rest_api_id             = aws_api_gateway_rest_api.api.id
  resource_id             = aws_api_gateway_resource.resources[each.key].id
  http_method             = aws_api_gateway_method.methods[each.key].http_method
  integration_http_method = "POST"
  type                    = "AWS_PROXY"
  content_handling        = "CONVERT_TO_TEXT"
  uri                     = "arn:aws:lambda:${var.current_region}:${var.current_awsaccount_id}:function:${each.value.lambda_name}"  #var.references.lambda_functions_arn[each.value.lambda_name]

  depends_on = [aws_api_gateway_resource.resources, aws_api_gateway_method.methods, aws_api_gateway_authorizer.authorizers]
}

resource "aws_api_gateway_authorizer" "authorizers" {
  # for_each = local.authorizers

  name                             = "authorizer"
  rest_api_id                      = aws_api_gateway_rest_api.api.id
  authorizer_uri                   = "arn:aws:lambda:${var.current_region}:${var.current_awsaccount_id}:function:${local.authorizers["authorizer"].lambda_name}"  #var.references.lambda_functions_arn[each.value.lambda_name]
  authorizer_credentials           = aws_iam_role.invocation_role.arn
  identity_source                  = try(local.authorizers["authorizer"].identity_source, "method.request.header.Authorization")
  authorizer_result_ttl_in_seconds = try(local.authorizers["authorizer"].authorizer_result_ttl_in_seconds, 0)
  identity_validation_expression   = "^[0-9]+$"
}


data "aws_iam_policy_document" "invocation_assume_role" {
  statement {
    effect = "Allow"

    principals {
      type        = "Service"
      identifiers = ["apigateway.amazonaws.com"]
    }

    actions = ["sts:AssumeRole"]
  }
}

resource "aws_iam_role" "invocation_role" {
  name               = "${local.name}_api_gateway_auth_invocation"
  path               = "/"
  assume_role_policy = data.aws_iam_policy_document.invocation_assume_role.json
}

data "aws_iam_policy_document" "invocation_policy" {
  statement {
    effect    = "Allow"
    actions   = ["lambda:InvokeFunction"]
    resources = [for key, value in local.authorizers : "arn:aws:lambda:${var.current_region}:${var.current_awsaccount_id}:function:${value.lambda_name}"]
  }
}

resource "aws_iam_role_policy" "invocation_policy" {
  name   = "${local.name}_api_gateway_invocation_policy"
  role   = aws_iam_role.invocation_role.id
  policy = data.aws_iam_policy_document.invocation_policy.json
}
